# ==========================================================================
# Exemplo de variáveis de ambiente. Copie para `.env` e ajuste os valores.
#   cp .env.example .env
# NUNCA faça commit do arquivo `.env` (ele está no .gitignore).
# ==========================================================================

# --- Django ---------------------------------------------------------------
# Módulo de settings: config.settings.dev (padrão local) ou config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere uma chave nova para produção, ex.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados -------------------------------------------------------
# DEV: deixe DATABASE_URL em branco/comentado para usar SQLite (arquivo local).
# PROD: aponte para o PostgreSQL, por exemplo:
#   DATABASE_URL=postgres://erp:senha@db:5432/erp
# DATABASE_URL=postgres://erp:erp@localhost:5432/erp

# --- CORS / CSRF ----------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Throttling (limites de requisição) -----------------------------------
THROTTLE_USER=10000/day
THROTTLE_ANON=100/hour

# --- Frontend -------------------------------------------------------------
# URL base do frontend, usada nos links de e-mail (convite, redefinição).
FRONTEND_URL=http://localhost:5173

# --- Clínica --------------------------------------------------------------
# Nome exibido no cabeçalho de impressões e no macro [NOME_UNIDADE] dos atestados.
CLINICA_NOME=Fontes Comportamentais

# --- Mídias / Amazon S3 ---------------------------------------------------
# DEV: deixe USE_S3=False (padrão) para salvar as mídias no disco local (MEDIA_ROOT).
# PROD: USE_S3=True guarda fotos/documentos/anexos em um bucket S3 PRIVADO, servido
#       por URLs assinadas e temporárias (exigência LGPD — bucket NUNCA público).
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=clinica-aprendizagem-midias
# AWS_S3_REGION_NAME=sa-east-1
# Credenciais do usuário IAM. Em EC2/ECS prefira IAM Role e deixe estas em branco.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Validade (segundos) das URLs assinadas de download. Padrão: 3600 (1h).
# AWS_QUERYSTRING_EXPIRE=3600
# Opcional: domínio do CloudFront na frente do bucket (deixe em branco para usar o S3).
# AWS_S3_CUSTOM_DOMAIN=

# --- E-mail ---------------------------------------------------------------
# DEV: por padrão o e-mail é impresso no console (não precisa configurar nada).
# PROD: descomente e configure o SMTP real.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Clínica da Aprendizagem <nao-responder@fontescomportamentais.com>

# --- WhatsApp (Meta Cloud API) --------------------------------------------
# DEV: deixe em branco para usar o modo simulado (só registra no log).
# PROD: credenciais da conta WhatsApp Business + token de verificação do webhook.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=
# --- Mídias / Amazon S3 ---------------------------------------------------
# DEV: deixe USE_S3=False (padrão) para salvar as mídias no disco local.
# PROD: USE_S3=True guarda fotos/documentos/anexos em um bucket S3 PRIVADO,
#       servido por URLs assinadas e temporárias (LGPD — bucket NUNCA público).
# As chaves reais vivem SÓ no .env da VM (nunca aqui, que é versionado).
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=clinica-aprendizagem-midias
# AWS_S3_REGION_NAME=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_QUERYSTRING_EXPIRE=3600

# --- Google Agenda (Calendar API) -----------------------------------------
# Sincroniza os agendamentos com o Google Agenda pessoal de cada profissional
# (mão única: app -> Google). Sem CLIENT_ID/SECRET a integração fica desligada.
# Credenciais em: Google Cloud Console -> APIs e Serviços -> Credenciais (OAuth).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Deve bater EXATAMENTE com a "URI de redirecionamento autorizada" do client OAuth.
#   DEV : http://localhost:8000/api/google/callback/
#   PROD: https://api.clinicadaaprendizagem.com.br/api/google/callback/
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback/
# Chave para criptografar os refresh tokens no banco (Fernet, base64 de 32 bytes).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Incluir nome do paciente/serviço no evento (evento é sempre "private"). LGPD.
# GOOGLE_EVENTO_COM_DADOS_PACIENTE=True
